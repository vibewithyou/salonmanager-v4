APP_NAME=SalonManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salonmanager
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Stripe Configuration
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# SMS Configuration (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Google Maps API
GOOGLE_MAPS_API_KEY=

# OpenAI API (for AI features)
OPENAI_API_KEY=

# Backup Configuration
BACKUP_DESTINATION=local
BACKUP_DISKS=local
BACKUP_NOTIFICATION_MAIL=

# Queue Configuration
QUEUE_FAILED_DRIVER=database-uuids

# Session Configuration
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Cache Configuration
CACHE_PREFIX=salonmanager_

# File Upload Configuration
UPLOAD_MAX_FILESIZE=10M
POST_MAX_SIZE=10M

# Security Configuration
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Localization
APP_LOCALE=de
APP_TIMEZONE=Europe/Berlin

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_ALLOWED_IPS=127.0.0.1

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=google

# PWA Configuration
PWA_NAME=SalonManager
PWA_SHORT_NAME=SalonManager
PWA_DESCRIPTION=Salon Management System
PWA_THEME_COLOR=#7C3AED
PWA_BACKGROUND_COLOR=#ffffff

# Notification Configuration
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:admin@salonmanager.com

# Backup Configuration
BACKUP_NOTIFICATION_MAIL=
BACKUP_DESTINATION=local
BACKUP_DISKS=local

# Monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Development
DEBUGBAR_ENABLED=true
TELESCOPE_ENABLED=true 